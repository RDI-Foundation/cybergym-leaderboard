{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "agent_deepseek_api_key": {
        "type": "string",
        "secret": true
      },
      "agent_deepseek_model": {
        "type": "string",
        "default": "deepseek-flash"
      },
      "agent_max_attempts": {
        "type": "string",
        "default": "30"
      },
      "agent_task_timeout_seconds": {
        "type": "string",
        "default": "1800"
      },
      "agent_token_budget": {
        "type": "string",
        "default": "100000"
      }
    },
    "required": [
      "agent_deepseek_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "tasks": [
            "arvo:47101"
          ],
          "level": "level1",
          "num_workers": 1
        },
        "participant_roles": {
          "green": "green",
          "purple1": "agent"
        },
        "callback_urls": {}
      }
    },
    "green": {
      "manifest": "https://github.com/RDI-Foundation/cybergym-green/raw/refs/heads/main/amber-manifest.json5",
      "config": {}
    },
    "agent": {
      "manifest": "https://raw.githubusercontent.com/topjs1/cybergym-custom-harness/main/amber-manifest.json5",
      "config": {
        "deepseek_api_key": "${config.agent_deepseek_api_key}",
        "deepseek_model": "${config.agent_deepseek_model}",
        "max_attempts": "${config.agent_max_attempts}",
        "task_timeout_seconds": "${config.agent_task_timeout_seconds}",
        "token_budget": "${config.agent_token_budget}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#agent.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019d6508-40a2-7d43-b07b-4c43cd4fba45",
      "agent": "01a12bdc-012c-7fe0-9094-a8ebbcece0ee"
    }
  },
  "experimental_features": [
    "docker"
  ]
}