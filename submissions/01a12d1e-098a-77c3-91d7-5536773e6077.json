{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "agent_deepseek_api_key": {
        "type": "string",
        "secret": true
      },
      "agent_deepseek_model": {
        "type": "string",
        "default": "deepseek-flash"
      },
      "agent_max_attempts": {
        "type": "string",
        "default": "60"
      },
      "agent_max_cost_usd": {
        "type": "string",
        "default": "5.0"
      },
      "agent_max_output_tokens": {
        "type": "string",
        "default": "8192"
      },
      "agent_mutation_attempts": {
        "type": "string",
        "default": "8"
      },
      "agent_recon_subagent": {
        "type": "string",
        "default": "true"
      },
      "agent_resume_nudges": {
        "type": "string",
        "default": "6"
      },
      "agent_reviewer_subagent": {
        "type": "string",
        "default": "true"
      },
      "agent_task_timeout_seconds": {
        "type": "string",
        "default": "1800"
      },
      "agent_token_budget": {
        "type": "string",
        "default": "500000"
      },
      "agent_tracks": {
        "type": "string",
        "default": "3"
      }
    },
    "required": [
      "agent_deepseek_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "tasks": [
            "arvo:47101",
            "arvo:3938",
            "arvo:24993",
            "arvo:1065",
            "arvo:10400",
            "arvo:368",
            "oss-fuzz:42535201",
            "oss-fuzz:42535468",
            "oss-fuzz:370689421",
            "oss-fuzz:385167047",
            "arvo:1461",
            "arvo:56179",
            "arvo:56037",
            "arvo:3012",
            "arvo:7067",
            "arvo:10710",
            "arvo:49427",
            "arvo:34374",
            "arvo:56150",
            "arvo:43012",
            "arvo:44597",
            "arvo:51045",
            "arvo:46543",
            "arvo:52102",
            "arvo:5797",
            "arvo:49801",
            "arvo:55985",
            "arvo:30403",
            "arvo:9351",
            "oss-fuzz:386128948"
          ],
          "level": "level1",
          "num_shards": 20,
          "num_workers": 1
        },
        "participant_roles": {
          "green": "green",
          "purple1": "agent"
        },
        "callback_urls": {}
      }
    },
    "green": {
      "manifest": "https://github.com/RDI-Foundation/cybergym-green/raw/refs/heads/main/amber-manifest.json5",
      "config": {}
    },
    "agent": {
      "manifest": "https://raw.githubusercontent.com/topjs1/cybergym-custom-harness/main/amber-manifest.json5",
      "config": {
        "deepseek_api_key": "${config.agent_deepseek_api_key}",
        "deepseek_model": "${config.agent_deepseek_model}",
        "max_attempts": "${config.agent_max_attempts}",
        "max_cost_usd": "${config.agent_max_cost_usd}",
        "max_output_tokens": "${config.agent_max_output_tokens}",
        "mutation_attempts": "${config.agent_mutation_attempts}",
        "recon_subagent": "${config.agent_recon_subagent}",
        "resume_nudges": "${config.agent_resume_nudges}",
        "reviewer_subagent": "${config.agent_reviewer_subagent}",
        "task_timeout_seconds": "${config.agent_task_timeout_seconds}",
        "token_budget": "${config.agent_token_budget}",
        "tracks": "${config.agent_tracks}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#agent.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019d6508-40a2-7d43-b07b-4c43cd4fba45",
      "agent": "01a12c79-9dc0-70f0-a5cb-fc1ed2ae56d2"
    }
  },
  "experimental_features": [
    "docker"
  ]
}